PORT=3000
NODE_ENV=production
BASE_URL=https://seu-app.onrender.com
DB_PATH=/data/shape.db
# Turso (persistência no Render grátis). Se estas duas existirem, o SQLite local não é usado.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Planos (preço em R$ e limite de alunos; limite vazio/0 = ilimitado). O /admin sobrescreve estes valores.
PLAN_BASICO_PRICE=29.90
PLAN_BASICO_LIMIT=15
PLAN_PRO_PRICE=49.90
PLAN_PRO_LIMIT=30
PLAN_ILIMITADO_PRICE=79.90
PLAN_ILIMITADO_LIMIT=0
# O teste grátis de personal novo dura 2 dias e está fixo em src/payments.js.
# Contas que já estavam em teste mantêm a data de fim gravada.
# Dono do sistema (painel /admin)
ADMIN_EMAIL=voce@exemplo.com
ADMIN_PASSWORD=troque-esta-senha
# Teste do dono: 100 cards e o ebook, sem olhar plano nem pagamento.
# Se OWNER_TEST_EMAILS não existir, vale o e-mail de ADMIN_EMAIL.
# Vários e-mails separados por vírgula. A conta do ADMIN_EMAIL também entra.
# Se só houver uma conta de personal no banco, ela entra também.
# Para desligar tudo depois, use off.
# OWNER_TEST_EMAILS=off
# Mercado Pago (https://www.mercadopago.com.br/developers/panel)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Stripe (opcional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# ALLOW_DEMO=1 mantém o botão de pagamento simulado mesmo com chaves (NÃO use em produção)
